# Copy to .env.local and fill in. Never commit .env.local.
# Create a bot with @BotFather, then message it and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Chat assistant ---
# Leave OLLAMA_MODEL empty to run in demo (mock) mode. Set it to go live.
OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=            # only if Ollama sits behind an auth proxy
# CHAT_PROVIDER=mock         # force demo mode even when OLLAMA_MODEL is set
